# Go build artifacts
/bin/
*.test
*.out
coverage.out

# C extensions (tree-sitter / cgo)
*.so
*.o
*.a

# DocuMind per-project index (stores embeddings + BM25 + sqlite)
.documind/

# Exclusive indexer lock (next to .documind/)
.documind-index.lock

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Env / secrets (none required today, but keep blocked)
.env
.env.*

# Legacy Python leftovers (kept so a mixed checkout stays clean)
__pycache__/
*.py[codz]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
